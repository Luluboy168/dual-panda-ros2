<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>franka_web</name>
  <version>2.0.0</version>
  <description>Operator web console for the multipanda dual-Panda bringup: one-command
startup, per-arm session control, health view, guarded jog or hand-off to your own ROS 2
publisher, live log drawer and session recording, configured by one optional YAML
file</description>
  <maintainer email="luluboy168@gmail.com">luluboy168</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>franka_bringup</exec_depend>
  <exec_depend>franka_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_test</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-jsonschema</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- A TEST dependency deliberately: franka_web must keep building,
       starting and running with franka_robotiq absent, so the config
       validator's import of it is lazy and guarded. -->
  <test_depend>franka_robotiq</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

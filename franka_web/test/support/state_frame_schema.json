    "diagnostic": {
      "description": "The canonical franka_bringup diagnostic_msgs/DiagnosticStatus for this arm. Frame rule 4: on mock hardware available is false, level is null and values is {}.",
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "level", "level_label", "message", "age_s", "values"],
      "properties": {

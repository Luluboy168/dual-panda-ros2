<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>franka_robotiq</name>
  <version>0.1.0</version>
  <description>Per-arm ROS 2 drivers for two Robotiq 2F-85 grippers on the dual-Panda
cell: one node per arm (panda1_robotiq, panda2_robotiq) speaking Modbus RTU over a
USB-RS485 adapter bound by its stable device name, exposing a GripperCommand action,
open/close/stop/reactivate services and joint-state and status topics</description>
  <maintainer email="luluboy168@gmail.com">luluboy168</maintainer>
  <license>Apache 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <!-- Runtime-resolved by `ros2 launch`; launch_ros is where Node(...) comes from. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

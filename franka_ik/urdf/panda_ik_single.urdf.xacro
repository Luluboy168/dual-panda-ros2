<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda_ik_single">
  <xacro:arg name="hand" default="false"/>

  <xacro:include filename="$(find franka_description)/robots/common/panda_arm.xacro"/>
  <xacro:panda_arm arm_id="panda" safety_distance="0.03"/>

  <xacro:if value="$(arg hand)">
    <xacro:include filename="$(find franka_description)/robots/common/hand.xacro"/>
    <xacro:hand
      ns="panda"
      connected_to="panda_link8"
      rpy="0 0 ${-pi/4}"
      safety_distance="0.03"/>
  </xacro:if>
</robot>

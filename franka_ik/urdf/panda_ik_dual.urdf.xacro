<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda_ik_dual">
  <xacro:arg name="hand_1" default="false"/>
  <xacro:arg name="hand_2" default="false"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
  </link>

  <xacro:include filename="$(find franka_description)/robots/common/panda_arm.xacro"/>
  <xacro:panda_arm
    arm_id="panda1"
    connected_to="base_link"
    rpy="0 0 0"
    xyz="0 +0.50 0"
    safety_distance="0.03"/>
  <xacro:panda_arm
    arm_id="panda2"
    connected_to="base_link"
    rpy="0 0 0"
    xyz="0 -0.50 0"
    safety_distance="0.03"/>

  <xacro:if value="$(arg hand_1)">
    <xacro:include filename="$(find franka_description)/robots/common/hand.xacro"/>
    <xacro:hand
      ns="panda1"
      connected_to="panda1_link8"
      rpy="0 0 ${-pi/4}"
      safety_distance="0.03"/>
  </xacro:if>
  <xacro:if value="$(arg hand_2)">
    <xacro:include filename="$(find franka_description)/robots/common/hand.xacro"/>
    <xacro:hand
      ns="panda2"
      connected_to="panda2_link8"
      rpy="0 0 ${-pi/4}"
      safety_distance="0.03"/>
  </xacro:if>
</robot>
